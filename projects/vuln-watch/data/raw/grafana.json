igured Prometheus server without restricting it to the supported API endpoints [missing path allowlist]. A user with permission to query the data source can read responses from other endpoints on that server using the data source's credentials."}],"affected":[{"source":"security@grafana.com","affectedData":[{"vendor":"Grafana","product":"Grafana OSS","defaultStatus":"unaffected","versions":[{"version":"9.1.0","lessThanOrEqual":"11.6.16","versionType":"semver","status":"affected"},{"version":"12.0.0","lessThanOrEqual":"12.2.10","versionType":"semver","status":"affected"},{"version":"12.3.0","lessThanOrEqual":"12.3.11","versionType":"semver","status":"affected"},{"version":"12.4.0","lessThan":"12.4.15","versionType":"semver","status":"affected"},{"version":"13.0.0","lessThan":"13.0.13","versionType":"semver","status":"affected"},{"version":"13.1.0","lessThan":"13.1.10","versionType":"semver","status":"affected"}]},{"vendor":"Grafana","product":"Grafana Enterprise","defaultStatus":"unaffected","versions":[{"version":"9.1.0","lessThanOrEqual":"11.6.16","versionType":"semver","status":"affected"},{"version":"12.0.0","lessThanOrEqual":"12.2.10","versionType":"semver","status":"affected"},{"version":"12.3.0","lessThanOrEqual":"12.3.11","versionType":"semver","status":"affected"},{"version":"12.4.0","lessThan":"12.4.15","versionType":"semver","status":"affected"},{"version":"13.0.0","lessThan":"13.0.13","versionType":"semver","status":"affected"},{"version":"13.1.0","lessThan":"13.1.10","versionType":"semver","status":"affected"}]},{"vendor":"Grafana","product":"Prometheus Datasource","defaultStatus":"unaffected","versions":[{"version":"13.1.1","lessThanOrEqual":"13.1.9","versionType":"semver","status":"affected"},{"version":"13.2.0","lessThan":"13.2.6","versionType":"semver","status":"affected"}]}]}],"metrics":{"cvssMetricV31":[{"source":"security@grafana.com","type":"Secondary","cvssData":{"version":"3.1","vectorString":"CVSS:3.1/AV:N/AC:H/PR:L/UI:N/S:C/C:H/I:N/A:N","baseScore":6.3,"baseSeverity":"MEDIUM","attackVector":"NETWORK","attackComplexity":"HIGH","privilegesRequired":"LOW","userInteraction":"NONE","scope":"CHANGED","confidentialityImpact":"HIGH","integrityImpact":"NONE","availabilityImpact":"NONE"},"exploitabilityScore":1.8,"impactScore":4.0}],"ssvcV203":[{"source":"134c704f-9b21-4f2e-91b3-4a467353bcc0","ssvcData":{"timestamp":"2026-11-17T16:02:14.464924Z","id":"CVE-2026-106472","options":[{"exploitation":"none"},{"automatable":"no"},{"technicalImpact":"partial"}],"role":"CISA Coordinator","version":"2.0.3"}}]},"weaknesses":[{"source":"security@grafana.com","type":"Secondary","description":[{"lang":"en","value":"CWE-918"}]}],"references":[{"url":"https://grafana.com/security/security-advisories/cve-2026-106472","source":"security@grafana.com"}]}},{"cve":{"id":"CVE-2026-81843","sourceIdentifier":"security@grafana.com","published":"2026-11-12T18:17:53.470","lastModified":"2026-11-17T17:18:10.100","vulnStatus":"Awaiting Analysis","cveTags":[],"descriptions":[{"lang":"en","value":"Grafana is an open-source platform for monitoring and observability.\n\nWhen an Elasticsearch data source is configured with a time-based index pattern, Grafana\ngenerated one index name for every interval in the requested query time range without any upper\nlimit. A user with permission to query the data source, which includes users holding only the\nViewer role in a default configuration, could submit a single small query with an extreme time\nrange and cause the server to allocate memory until it was terminated. The allocation occurred\nbefore any request was sent to Elasticsearch, so the condition applied whether or not the\nElasticsearch cluster was reachable.\n\nData sources configured with a static index name are not affected."}],"affected":[{"source":"security@grafana.com","affectedData":[{"vendor":"Grafana","product":"Grafana OSS","defaultStatus":"unaffected","versions":[{"version":"11.6.0","lessThanOrEqual":"11.6.16","versionType":"semver","status":"affected"},{"version":"12.0.0","lessThanOrEqual":"12.2.10","versionType":"semver","status":"affected"},{"version":"12.3.0","lessThan":"12.4.15","versionType":"semver","status":"affected"}]},{"vendor":"Grafana","product":"Elasticsearch Datasource","defaultStatus":"unaffected","versions":[{"version":"12.4.2","lessThan":"12.9.6","versionType":"semver","status":"affected"}]},{"vendor":"Grafana","product":"Grafana Enterprise","defaultStatus":"unaffected","versions":[{"version":"11.6.0","lessThanOrEqual":"11.6.16","versionType":"semver","status":"affected"},{"version":"12.0.0","lessThanOrEqual":"12.2.10","versionType":"semver","status":"affected"},{"version":"12.3.0","lessThan":"12.4.15","versionType":"semver","status":"affected"}]}]}],"metrics":{"cvssMetricV31":[{"source":"security@grafana.com","type":"Secondary","cvssData":{"version":"3.1","vectorString":"CVSS:3.1/AV:N/AC:L/PR:L/UI:N/S:U/C:N/I:N/A:H","baseScore":6.5,"baseSeverity":"MEDIUM","attackVector":"NETWORK","attackComplexity":"LOW","privilegesRequired":"LOW","userInteraction":"NONE","scope":"UNCHANGED","confidentialityImpact":"NONE","integrityImpact":"NONE","availabilityImpact":"HIGH"},"exploitabilityScore":2.8,"impactScore":3.6}],"ssvcV203":[{"source":"134c704f-9b21-4f2e-91b3-4a467353bcc0","ssvcData":{"timestamp":"2026-11-17T16:02:17.321454Z","id":"CVE-2026-81843","options":[{"exploitation":"none"},{"automatable":"no"},{"technicalImpact":"partial"}],"role":"CISA Coordinator","version":"2.0.3"}}]},"weaknesses":[{"source":"security@grafana.com","type":"Secondary","description":[{"lang":"en","value":"CWE-770"}]}],"references":[{"url":"https://grafana.com/security/security-advisories/cve-2026-81843","source":"security@grafana.com"}]}},{"cve":{"id":"CVE-2026-110337","sourceIdentifier":"security@grafana.com","published":"2026-11-19T13:17:26.427","lastModified":"2026-11-23T16:06:05.540","vulnStatus":"Awaiting Analysis","cveTags":[],"descriptions":[{"lang":"en","value":"The Strava datasource plugin's resource handler POST /strava-api forwards a client-supplied endpoint string, and its query parameters, to the Strava API (https://www.strava.com/api/v3/<endpoint>) without validation.\n\nWhen the datasource is not in OAuth pass-through mode, the request is made with the access token stored on the datasource, not the caller's identity. Grafana authorises plugin resource calls only on the datasources:query permission, which Viewers have by default. Any such caller could therefore request any Strava API path the connected account's OAuth grant allows, for example athlete/clubs or routes/{id}, and read the response.\n\nThe plugin's frontend (stravaApi.ts) only needs a fixed set of paths: athlete, athlete/activities, activities/{id}, activities/{id}/streams and segments/{id}.\n\nRequests to Strava are GET only, so the issue is read-only.\n\nAffected: plugin versions 1.2.0 through 1.7.2. The fix restricts endpoint to those five patterns and is pending release. The check runs before the access token is resolved, so a rejected request never causes a token refresh or any call to Strava. Paths with .. segments are rejected as well."}],"affected":[{"source":"security@grafana.com","affectedData":[{"vendor":"Grafana","product":"Strava Datasource","defaultStatus":"unaffected","versions":[{"version":"1.2.0","lessThanOrEqual":"1.7.2","versionType":"semver","status":"affected"}]}]}],"metrics":{"cvssMetricV31":[{"source":"security@grafana.com","type":"Secondary","cvssData":{"version":"3.1","vectorString":"CVSS:3.1/AV:N/AC:H/PR:L/UI:N/S:C/C:L/I:N/A:N","baseScore":3.5,"baseSeverity":"LOW","attackVector":"NETWORK","attackComplexity":"HIGH","privilegesRequired":"LOW","userInteraction":"NONE","scope":"CHANGED","confidentialityImpact":"LOW","integrityImpact":"NONE","availabilityImpact":"NONE"},"exploitabilityScore":1.8,"impactScore":1.4}],"ssvcV203":[{"source":"134c704f-9b21-4f2e-91b3-4a467353bcc0","ssvcData":{"timestamp":"2026-11-19T16:32:06.365406Z","id":"CVE-2026-110337","options":[{"exploitation":"none"},{"automatable":"no"},{"technicalImpact":"partial"}],"role":"CISA Coordinator","version":"2.0.3"}}]},"weaknesses":[{"source":"134c704f-9b21-4f2e-91b3-4a467353bcc0","type":"Secondary","description":[{"lang":"en","value":"CWE-863"}]}],"references":[{"url":"https://grafana.com/security/security-advisories/cve-2026-110337","source":"security@grafana.com"}]}},{"cve":{"id":"CVE-2026-60078","sourceIdentifier":"security@apache.org","published":"2026-11-23T15:17:55.223","lastModified":"2026-11-23T15:17:55.223","vulnStatus":"Received","cveTags":[],"descriptions":[{"lang":"en","value":"Allocation of resources without limits or throttling vulnerability in Apache IoTDB. Authenticated Grafana clients can bypass row-limit cap to trigger heap-exhaustion DoS.\n\n\n\nThis issue affects Apache IoTDB: from 0.13.0 through 2.0.11.\n\n\n\nUsers are recommended to upgrade to version 2.0.12, which fixes the issue."}],"affected":[{"source":"security@apache.org","affectedData":[{"vendor":"Apache Software Foundation","product":"Apache IoTDB","defaultStatus":"unaffected","versions":[{"version":"0.13.0","lessThanOrEqual":"2.0.11","versionType":"semver","status":"affected"}]}]}],"metrics":{},"weaknesses":[{"source":"security@apache.org","type":"Primary","description":[{"lang":"en","value":"CWE-770"}]}],"references":[{"url":"https://lists.apache.org/thread.html/577tf8nw6vddj7kkglyr72g3hxmhp6k8","source":"security@apache.org"},{"url":"http://www.openwall.com/lists/oss-security/2026/11/23/12","source":"af854a3a-2127-422b-91ae-364da2661108"}]}},{"cve":{"id":"CVE-2026-10084","sourceIdentifier":"security@grafana.com","published":"2026-11-24T08:17:04.263","lastModified":"2026-11-24T08:17:04.263","vulnStatus":"Received","cveTags":[],"descriptions":[{"lang":"en","value":"An unauthenticated attacker can send an unsigned SAML single logout request to force users to log out of Grafana Enterprise instances configured for SAML single logout (improper signature verification)."}],"affected":[{"source":
ity-advisories@github.com","published":"2026-11-06T19:17:44.393","lastModified":"2026-11-12T20:04:52.377","vulnStatus":"Awaiting Analysis","cveTags":[],"descriptions":[{"lang":"en","value":"GROBID is machine learning software for extracting information from scholarly documents. Prior to 0.9.1, the Linux non-server PDF conversion path in grobid-core/src/main/java/org/grobid/core/document/DocumentSource.java passes an attacker-influenced PDF filename through DocumentSource.pdfalto, which interpolates the path into a bash -c command string. A single quote in the filename can terminate the intended quoting, and ProcessRunner.run in grobid-core/src/main/java/org/grobid/core/process/ProcessRunner.java starts the resulting command through ProcessBuilder, allowing arbitrary commands to execute with GROBID process privileges. The bundled REST server path is not affected. This issue is fixed in version 0.9.1."}],"affected":[{"source":"security-advisories@github.com","affectedData":[{"vendor":"grobidOrg","product":"grobid","versions":[{"version":"< 0.9.1","status":"affected"}]}]}],"metrics":{"cvssMetricV31":[{"source":"security-advisories@github.com","type":"Secondary","cvssData":{"version":"3.1","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:N","baseScore":0.0,"baseSeverity":"NONE","attackVector":"NETWORK","attackComplexity":"LOW","privilegesRequired":"NONE","userInteraction":"NONE","scope":"UNCHANGED","confidentialityImpact":"NONE","integrityImpact":"NONE","availabilityImpact":"NONE"},"exploitabilityScore":3.9,"impactScore":0.0}],"ssvcV203":[{"source":"134c704f-9b21-4f2e-91b3-4a467353bcc0","ssvcData":{"timestamp":"2026-11-06T19:33:16.236459Z","id":"CVE-2026-123357","options":[{"exploitation":"none"},{"automatable":"yes"},{"technicalImpact":"partial"}],"role":"CISA Coordinator","version":"2.0.3"}}]},"weaknesses":[{"source":"security-advisories@github.com","type":"Secondary","description":[{"lang":"en","value":"CWE-78"}]}],"references":[{"url":"https://github.com/grobidOrg/grobid/pull/1477","source":"security-advisories@github.com"},{"url":"https://github.com/grobidOrg/grobid/releases/tag/0.9.1","source":"security-advisories@github.com"},{"url":"https://github.com/grobidOrg/grobid/security/advisories/GHSA-mgxf-7mg7-qpmf","source":"security-advisories@github.com"}]}},{"cve":{"id":"CVE-2026-63496","sourceIdentifier":"security-advisories@github.com","published":"2026-11-09T22:18:53.473","lastModified":"2026-11-14T03:17:30.093","vulnStatus":"Deferred","cveTags":[],"descriptions":[{"lang":"en","value":"augment-vir is a collection of helper functions. Prior to version 31.73.5, the grep() function exported by @augment-vir/node inserts caller-controlled search patterns directly into a double-quoted shell command string without sanitization (grep.ts:310). When the constructed command is passed to spawn() with shell: 'bash' (shell.ts:98-99), bash evaluates $() command substitution expressions embedded in the pattern, resulting in arbitrary OS command execution as the Node.js process user. Any downstream application that passes untrusted input to grep()'s pattern or patterns field is vulnerable to unauthenticated local (and potentially remote) code execution. This issue has been patched in version 31.73.5."}],"affected":[{"source":"security-advisories@github.com","affectedData":[{"vendor":"electrovir","product":"augment-vir","versions":[{"version":"< 31.73.5","status":"affected"}]}]}],"metrics":{"cvssMetricV31":[{"source":"security-advisories@github.com","type":"Secondary","cvssData":{"version":"3.1","vectorString":"CVSS:3.1/AV:L/AC:L/PR:N/UI:R/S:U/C:H/I:H/A:H","baseScore":7.8,"baseSeverity":"HIGH","attackVector":"LOCAL","attackComplexity":"LOW","privilegesRequired":"NONE","userInteraction":"REQUIRED","scope":"UNCHANGED","confidentialityImpact":"HIGH","integrityImpact":"HIGH","availabilityImpact":"HIGH"},"exploitabilityScore":1.8,"impactScore":5.9}],"ssvcV203":[{"source":"134c704f-9b21-4f2e-91b3-4a467353bcc0","ssvcData":{"timestamp":"2026-11-14T02:16:44.289380Z","id":"CVE-2026-63496","options":[{"exploitation":"poc"},{"automatable":"no"},{"technicalImpact":"total"}],"role":"CISA Coordinator","version":"2.0.3"}}]},"weaknesses":[{"source":"security-advisories@github.com","type":"Secondary","description":[{"lang":"en","value":"CWE-78"}]}],"references":[{"url":"https://github.com/electrovir/augment-vir/commit/9e1a3592903a56e500959be72276ede1708c3437","source":"security-advisories@github.com"},{"url":"https://github.com/electrovir/augment-vir/releases/tag/v31.73.5","source":"security-advisories@github.com"},{"url":"https://github.com/electrovir/augment-vir/security/advisories/GHSA-xvcc-vqjv-phqh","source":"security-advisories@github.com"},{"url":"https://github.com/electrovir/augment-vir/security/advisories/GHSA-xvcc-vqjv-phqh","source":"134c704f-9b21-4f2e-91b3-4a467353bcc0"}]}},{"cve":{"id":"CVE-2026-121716","sourceIdentifier":"security-advisories@github.com","published":"2026-11-17T20:17:36.727","lastModified":"2026-11-17T23:17:45.603","vulnStatus":"Received","cveTags":[],"descriptions":[{"lang":"en","value":"fzf is a command-line fuzzy finder. Prior to 0.74.5, bin/fzf-tmux validates separately supplied layout sizes but does not validate attached -l and -u layout values before Bash arithmetic expansion, allowing command substitution in a crafted operand to execute as the invoking user during option parsing. The same validation failure lets space-bearing popup geometry options -x, -y, -w, -h, and -p reach an unquoted tmux popup option string and inject additional tmux flags. Exploitation requires less-trusted project configuration, a wrapper, or a plugin to supply the poisoned value and requires the victim to invoke fzf-tmux; normal values are usually trusted, and the script has been superseded by built-in tmux options. This issue is fixed in version 0.74.5."}],"affected":[{"source":"security-advisories@github.com","affectedData":[{"vendor":"junegunn","product":"fzf","versions":[{"version":"< 0.74.5","status":"affected"}]}]}],"metrics":{"cvssMetricV31":[{"source":"security-advisories@github.com","type":"Secondary","cvssData":{"version":"3.1","vectorString":"CVSS:3.1/AV:L/AC:H/PR:N/UI:R/S:U/C:H/I:H/A:H","baseScore":7.0,"baseSeverity":"HIGH","attackVector":"LOCAL","attackComplexity":"HIGH","privilegesRequired":"NONE","userInteraction":"REQUIRED","scope":"UNCHANGED","confidentialityImpact":"HIGH","integrityImpact":"HIGH","availabilityImpact":"HIGH"},"exploitabilityScore":1.0,"impactScore":5.9}],"ssvcV203":[{"source":"134c704f-9b21-4f2e-91b3-4a467353bcc0","ssvcData":{"timestamp":"2026-11-17T22:17:29.449967Z","id":"CVE-2026-121716","options":[{"exploitation":"none"},{"automatable":"no"},{"technicalImpact":"total"}],"role":"CISA Coordinator","version":"2.0.3"}}]},"weaknesses":[{"source":"security-advisories@github.com","type":"Secondary","description":[{"lang":"en","value":"CWE-78"}]}],"references":[{"url":"https://github.com/junegunn/fzf/commit/f126ff29549e0983f571fbc32dddcfbede251aa7","source":"security-advisories@github.com"},{"url":"https://github.com/junegunn/fzf/releases/tag/v0.74.5","source":"security-advisories@github.com"},{"url":"https://github.com/junegunn/fzf/security/advisories/GHSA-w6x2-f5m4-xw82","source":"security-advisories@github.com"}]}},{"cve":{"id":"CVE-2026-129987","sourceIdentifier":"security-advisories@github.com","published":"2026-11-18T22:17:18.237","lastModified":"2026-11-19T16:19:51.080","vulnStatus":"Deferred","cveTags":[],"descriptions":[{"lang":"en","value":"Dokploy is a free, self-hostable Platform as a Service (PaaS). Prior to 0.31.1, the database password validation used by the MySQL, PostgreSQL, MariaDB, MongoDB, and Redis change-password procedures permits backticks, and the procedures interpolate attacker-controlled passwords into Bash command strings. An authenticated user who can update a database password can trigger command substitution before the database command runs, resulting in arbitrary operating-system command execution 
dmin/release-notes#3.19.16","source":"product-cna@github.com"},{"url":"https://docs.github.com/en/enterprise-server@3.20/admin/release-notes#3.20.12","source":"product-cna@github.com"},{"url":"https://docs.github.com/en/enterprise-server@3.21/admin/release-notes#3.21.10","source":"product-cna@github.com"},{"url":"https://docs.github.com/en/enterprise-server@3.22/admin/release-notes#3.22.5","source":"product-cna@github.com"}]}},{"cve":{"id":"CVE-2026-59159","sourceIdentifier":"security-advisories@github.com","published":"2026-11-18T17:17:49.060","lastModified":"2026-11-18T17:17:49.060","vulnStatus":"Received","cveTags":[],"descriptions":[{"lang":"en","value":"Linux Mint Update Manager manages software updates on Linux Mint systems. From 5.4.8 until 5.5.4.3, 5.5.9.1, 5.8.8.1, 5.9.8.1, 6.0.9.1, and 6.1.5.1, mint-refresh-cache passes a user-controlled --parent-window-id value directly to the privileged Synaptic process without validating it as an integer. A local user permitted to execute mint-refresh-cache through sudo can inject additional Synaptic command-line options and achieve arbitrary code execution as root. This issue is fixed in versions 5.5.4.3, 5.5.9.1, 5.8.8.1, 5.9.8.1, 6.0.9.1, and 6.1.5.1."}],"affected":[{"source":"security-advisories@github.com","affectedData":[{"vendor":"linuxmint","product":"linuxmint","versions":[{"version":">= 5.4.8, < 5.5.4.3","status":"affected"},{"version":">= 5.5.5, < 5.5.9.1","status":"affected"},{"version":">= 5.6.0, < 5.8.8.1","status":"affected"},{"version":">= 5.9.0, < 5.9.8.1","status":"affected"},{"version":">= 6.0.0, < 6.0.9.1","status":"affected"},{"version":">= 6.1.0, < 6.1.5.1","status":"affected"}]}]}],"metrics":{"cvssMetricV40":[{"source":"security-advisories@github.com","type":"Secondary","cvssData":{"version":"4.0","vectorString":"CVSS:4.0/AV:L/AC:L/AT:N/PR:L/UI:N/VC:H/VI:H/VA:H/SC:N/SI:N/SA:N/E:X/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X","baseScore"
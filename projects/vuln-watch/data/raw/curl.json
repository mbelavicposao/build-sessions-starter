nticated HTTP request. A standard user can trigger the LotW import, although changing lotw_download_url normally requires installer administrator access, and related vulnerabilities can remove that prerequisite. The same missing status-validation pattern affects the LotW lotw_users fetch helper and per-user download helper. This exposes files readable by the www-data user, including environment data, mounted secrets, and application configuration. This issue is fixed in version 3.2.4."}],"affected":[{"source":"security-advisories@github.com","affectedData":[{"vendor":"wavelog","product":"wavelog","versions":[{"version":"< 3.2.4","status":"affected"}]}]}],"metrics":{"cvssMetricV31":[{"source":"security-advisories@github.com","type":"Secondary","cvssData":{"version":"3.1","vectorString":"CVSS:3.1/AV:N/AC:L/PR:H/UI:N/S:U/C:H/I:N/A:N","baseScore":4.9,"baseSeverity":"MEDIUM","attackVector":"NETWORK","attackComplexity":"LOW","privilegesRequired":"HIGH","userInteraction":"NONE","scope":"UNCHANGED","confidentialityImpact":"HIGH","integrityImpact":"NONE","availabilityImpact":"NONE"},"exploitabilityScore":1.2,"impactScore":3.6}],"ssvcV203":[{"source":"134c704f-9b21-4f2e-91b3-4a467353bcc0","ssvcData":{"timestamp":"2026-11-19T15:03:34.282891Z","id":"CVE-2026-55505","options":[{"exploitation":"none"},{"automatable":"no"},{"technicalImpact":"partial"}],"role":"CISA Coordinator","version":"2.0.3"}}]},"weaknesses":[{"source":"security-advisories@github.com","type":"Secondary","description":[{"lang":"en","value":"CWE-200"},{"lang":"en","value":"CWE-918"}]}],"references":[{"url":"https://github.com/wavelog/wavelog/commit/6f16eaccea942e2fb91af4658ce4ae106087daec","source":"security-advisories@github.com"},{"url":"https://github.com/wavelog/wavelog/pull/3886","source":"security-advisories@github.com"},{"url":"https://github.com/wavelog/wavelog/releases/tag/3.2.4","source":"security-advisories@github.com"},{"url":"https://github.com/wavelog/wavelog/security/advisories/GHSA-5xph-jv49-jjr8","source":"security-advisories@github.com"}]}},{"cve":{"id":"CVE-2026-55372","sourceIdentifier":"security-advisories@github.com","published":"2026-11-20T19:18:52.607","lastModified":"2026-11-20T19:18:52.607","vulnStatus":"Received","cveTags":[],"descriptions":[{"lang":"en","value":"NukeViet CMS is a multi Content Management System. Prior to 4.5.09, an unauthenticated attacker can submit the __serverInfoUpdate=1 field while controlling X-Forwarded-Host and X-Forwarded-Proto. NukeViet\\Core\\Server::standardizeHost() did not validate the forwarded host against my_domains, and a trailing slash could preserve an attacker-selected port that server_info_update() used to construct a cURL request in includes/ini.php before authentication. The blind, HEAD-only request uses a fixed path, but it permits internal host and port discovery and can poison cached server_headers. This issue is fixed in version 4.5.09."}],"affected":[{"source":"security-advisories@github.com","affectedData":[{"vendor":"nukeviet","product":"nukeviet","versions":[{"version":"< 4.5.09","status":"affected"}]}]}],"metrics":{"cvssMetricV31":[{"source":"security-advisories@github.com","type":"Secondary","cvssData":{"version":"3.1","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:C/C:L/I:L/A:N","baseScore":7.2,"baseSeverity":"HIGH","attackVector":"NETWORK","attackComplexity":"LOW","privilegesRequired":"NONE","userInteraction":"NONE","scope":"CHANGED","confidentialityImpact":"LOW","integrityImpact":"LOW","availabilityImpact":"NONE"},"exploitabilityScore":3.9,"impactScore":2.7}],"ssvcV203":[{"source":"134c704f-9b21-4f2e-91b3-4a467353bcc0","ssvcData":{"timestamp":"2026-11-20T19:09:55.351273Z","id":"CVE-2026-55372","options":[{"exploitation":"poc"},{"automatable":"yes"},{"technicalImpact":"partial"}],"role":"CISA Coordinator","version":"2.0.3"}}]},"weaknesses":[{"source":"security-advisories@github.com","type":"Primary","description":[{"lang":"en","value":"CWE-918"}]}],"references":[{"url":"https://github.com/nukeviet/nukeviet/commit/a16d6dc9891fb38d5ad16b64e0303910adf94c01","source":"security-advisories@github.com"},{"url":"https://github.com/nukeviet/nukeviet/commit/f0e06cd543feff7d21f683a9be9b0b06e7192bf3","source":"security-advisories@github.com"},{"url":"https://github.com/nukeviet/nukeviet/releases/tag/4.5.09","source":"security-advisories@github.com"},{"url":"https://github.com/nukeviet/nukeviet/security/advisories/GHSA-4chg-4752-w88r","source":"security-advisories@github.com"},{"url":"https://github.com/nukeviet/nukeviet/security/advisories/GHSA-4chg-4752-w88r","source":"134c704f-9b21-4f2e-91b3-4a467353bcc0"}]}},{"cve":{"id":"CVE-2026-94561","sourceIdentifier":"security-advisories@github.com","published":"2026-11-20T19:18:55.910","lastModified":"2026-11-20T19:18:55.910","vulnStatus":"Received","cveTags":[],"descriptions":[{"lang":"en","value":"NukeViet CMS is a multi Content Management System. In 4.6.00, an unauthenticated attacker can place the configured domain in X-Forwarded-Host while choosing a different destination in the ordinary Host header. The earlier fix validates only the forwarded value in includes/mainfile.php, while set_ini_file() in includes/ini.php constructs an outbound cURL request from the separately retained NV_SERVER_NAME before the ordinary host is rejected. Redirect following can carry the blind request to an attacker-selected private host, port, and path and invoke internal HTTP endpoints. This issue is fixed in version 4.6.01."}],"affected":[{"source":"security-advisories@github.com","affectedData":[{"vendor":"nukeviet","product":"nukeviet","versions":[{"version":">= 4.6.00, < 4.6.01","status":"affected"}]}]}],"metrics":{"cvssMetricV31":[{"source":"security-advisories@github.com","type":"Secondary","cvssData":{"version":"3.1","vectorString":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:C/C:L/I:L/A:N","baseScore":7.2,"baseSeverity":"HIGH","attackVector":"NETWORK","attackComplexity":"LOW","privilegesRequired":"NONE","userInteraction":"NONE","scope":"CHANGED","confidentialityImpact":"LOW","integrityImpact":"LOW","availabilityImpact":"NONE"},"exploitabilityScore":3.9,"impactScore":2.7}]},"weaknesses":[{"source":"security-advisories@github.com","type":"Primary","description":[{"lang":"en","value":"CWE-918"}]}],"references":[{"url":"https://github.com/nukeviet/nukeviet/commit/a2ceabdacd5fb3135bde6cdfb106e76b24736095","source":"security-advisories@github.com"},{"url":"https://github.com/nukeviet/nukeviet/commit/b5305fe257a7487c7b8fbe74b31a9554793be720","source":"security-advisories@github.com"},{"url":"https://github.com/nukeviet/nukeviet/releases/tag/4.6.01","source":"security-advisories@github.com"},{"url":"https://github.com/nukeviet/nukeviet/security/advisories/GHSA-8xch-674f-grqr","source":"security-advisories@github.com"},{"url":"https://nukeviet.vn/vi/news/Tin-tuc/thong-bao-phat-hanh-nukeviet-4-6-01-857.html","source":"security-advisories@github.com"}]}},{"cve":{"id":"CVE-2026-94563","sourceIdentifier":"security-advisories@github.com","published":"2026-11-20T19:18:56.210","lastModified":"2026-11-24T01:17:35.937","vulnStatus":"Received","cveTags":[],"descriptions":[{"lang":"en","value":"NukeViet CMS is a multi Content Management System. From 4.5.00 until 4.6.01, an authenticated settings-module administrator can upload a PKCS#12 S/MIME certificate whose X.509 Subject CN contains path separators and traversal components. The smimeadd handler in admin/settings/smtp.php applies only an at-sign replacement before using the CN in .key, .crt, and .pem paths beneath data/certs. Traversal can select attacker-chosen paths outside data/certs, but writes remain constrained to already-existing writable directories and the permitted extensions. Within that constraint, attacker-controlled PEM data can overwrite certificate assets, including a DKIM private key; when the curl.cainfo PHP directive is empty, the attacker can also replace cacert.pem and undermine outbound TLS verification. This issue is fixed in version 4.6.01."}],"affected":[{"source":"security-advisories@github.com","affectedData":[{"vendor":"nukeviet","product":"nukeviet","versions":[{"version":">= 4.5.00, < 4.6.01","status":"affected"}]}]}],"metrics":{"cvssMetricV31":[{"source":"security-advisories@github.com","type":"Secondary","cvssData":{"version":"3.1","vectorString":"CVSS:3.1/AV:N/AC:L/PR:H/UI:N/S:U/C:L/I:H/A:L","baseScore":6.0,"baseSeverity":"MEDIUM","attackVector":"NETWORK","attackComplexity":"LOW","privilegesRequired":"HIGH","userInteraction":"NONE","scope":"UNCHANGED","confidentialityImpact":"LOW","integrityImpact":"HIGH","availabilityImpact":"LOW"},"exploitabilityScore":1.2,"impactScore":4.7}],"ssvcV203":[{"source":"134c704f-9b21-4f2e-91b3-4a467353bcc0","ssvcData":{"timestamp":"2026-11-24T00:22:31.186271Z","id":"CVE-2026-94563","options":[{"exploitation":"none"},{"automatable":"no"},{"technicalImpact":"partial"}],"role":"CISA Coordinator","version":"2.0.3"}}]},"weaknesses":[{"source":"security-advisories@github.com","type":"Secondary","description":[{"lang":"en","value":"CWE-22"},{"lang":"en","value":"CWE-73"}]}],"references":[{"url":"https://github.com/nukeviet/nukeviet/commit/8f7b3698f1c08b6cdedb500a0d2d2f528d4f0c87","source":"security-advisories@github.com"},{"url":"https://github.com/nukeviet/nukeviet/releases/tag/4.6.01","source":"security-advisories@github.com"},{"url":"https://github.com/nukeviet/nukeviet/security/advisories/GHSA-j79f-jrwm-2f2h","source":"security-advisories@github.com"},{"url":"https://nukeviet.vn/vi/news/Tin-tuc/thong-bao-phat-hanh-nukeviet-4-6-01-857.html","source":"security-advisories@github.com"}]}},{"cve":{"id":"CVE-2026-135252","sourceIdentifier":"5a6e4751-2f3f-4070-9419-94fb35b644e8","published":"2026-11-23T16:17:44.520","lastModified":"2026-11-23T16:17:44.627","vulnStatus":"Deferred","cveTags":[],"descriptions":[{"lang":"en","value":"MISP contains a Server-Side Request Forgery (SSRF) vulnerability in its feed and sync HTTP request handling. When the application uses libcurl as the HTTP transport, the CURLOPT_FOLLOWLOCATION option was enabled by default, causing the library to automatically follow HTTP redirects without the application's own per-hop validation logic being invoked.\n\n- Feed requests: MISP implements its own redirect validation for feed sources, but libcurl was following redirects before that validation could execute, allowing a malicious or compromised feed source to redirect the request to arbitrary internal URLs.\n- Sync requests: Sync peers are server-configured, and the application does not perform per-hop redirect validation for sync traffic. libcurl's automatic redirect following allowed a malicious sync peer to redirect the request to internal network resources.\n\nAn attacker who is a configured sync peer, controls a feed source URL, or can influence DNS resolution for a configured endpoint can exploit this to cause the MISP server to issue requests to arbitrary internal services, potentially reading sensitive data or interacting with internal APIs that are not otherwise exposed.\n\nAffected: MISP versions prior to 2.5.52."}],"affected":[{"source":"5a6e4751-2f3f-4070-9419-94fb35b644e8","affectedData":[{"vendor":"MISP","product":"MISP","cpes":["cpe:2.3:a:misp:misp:*:*:*:*:*:*:*:*"],"modules":["app/Lib/Tools/SyncTool.php"],"programFiles":["app/Lib/Tools/SyncTool.php"],"repo":"https://github.com/MISP/MISP","versions":[{"version":"0","lessThan":"2.5.52","versionType":"semver","status":"affected"}]}]}],"metrics":{"cvssMetricV40":[{"source":"5a6e4751-2f3f-4070-9419-94fb35b644e8","type":"Secondary","cvssData":{"version":"4.0","vectorString":"CVSS:4.0/AV:N/AC:L/AT:N/PR:L/UI:N/VC:H/VI:N/VA:N/SC:N/SI:N/SA:N/E:X/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X","baseScore":7.1,"baseSeverity":"HIGH","attackVector":"NETWORK","attackComplexity":"LOW","attackRequirements":"NONE","privilegesRequired":"LOW","userInteraction":"NONE","vulnConfidentialityImpact":"HIGH","vulnIntegrit